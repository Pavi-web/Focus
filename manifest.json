{
  "manifest_version": 3,
  "name": "Study Focus Blocker",
  "version": "1.0",
  "description": "Blocks distracting websites while studying.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "blocked.html"
  }
}
